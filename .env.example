# ---- HTTP ----
PORT=
HOST=

# ---- SQL Server ----
DB_SERVER=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_INSTANCE=
DB_ENCRYPT=
DB_TRUST_SERVER_CERTIFICATE=
DB_POOL_MAX=

# ---- Behaviour ----
# Dataset cache TTL in seconds (30..86400). Keep the name: the API console shows it.
STOCK_SOURCE_CACHE_TTL_SECONDS=
STOCK_SOURCE_TIMEOUT_MS=

# Owner stored on WIP tags. Every user shares this value because the API is open
# (no login). Set one value per site so tags stay stable.
WIP_TAG_OWNER=

# Serve the built client from this process (true) or let nginx do it (false).
SERVE_STATIC=
CLIENT_DIST=
